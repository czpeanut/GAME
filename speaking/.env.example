# Get a key at https://aistudio.google.com/apikey (free tier available).
# Used for both the Q&A answers and the text-to-speech voice.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# The voice, and how to tell it to deliver the line. The page can try both
# without a redeploy - GET /api/voices lists what is allowed, and an
# unrecognised name here is ignored in favour of the default.
GEMINI_TTS_VOICE=Leda
GEMINI_TTS_TONE=default
PORT=3000
