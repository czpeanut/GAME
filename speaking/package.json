{
  "name": "speaking-puppet",
  "version": "3.0.0",
  "description": "Ask a question, get a Gemini answer, and watch a cut-out puppet speak it — Gemini TTS with envelope-driven lip sync, no third-party avatar service.",
  "private": true,
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "build": "node scripts/build-client.js",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node test/lipsync.test.mjs",
    "test:browser": "node test/smoke.browser.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
