; Engine configuration file. Edit through the Godot editor or as plain text.
config_version=5

[application]
config/name="焦土台灣：焦土歸途 - Ch.1 灰盒原型"
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[autoload]
Balance="*res://scripts/autoload/balance.gd"
GameState="*res://scripts/autoload/game_state.gd"
Acoustics="*res://scripts/autoload/acoustics.gd"
Sfx="*res://scripts/autoload/sfx.gd"

[display]
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[layer_names]
2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemy"
2d_physics/layer_4="shutter"
2d_physics/layer_5="low_obstacle"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
